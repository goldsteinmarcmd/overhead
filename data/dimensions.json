  "_schema": {
    "note": "Physical dimensions for Earth-relative sizing. characteristicLengthM is the largest on-orbit extent (usually solar-array or antenna span) used as a single scalar for point/mesh scale. Earth mean radius = 6371 km.",
    "fields": {
      "characteristicLengthM": "Largest deployed extent in meters — use for scene size = lengthKm / EARTH_RADIUS_KM.",
      "bodyM": "Bus / pressurized structure dimensions when known (L×W×H or L×D).",
      "deployedM": "Full on-orbit envelope including arrays/antennas when known.",
      "confidence": "published | reported | estimated",
      "note": "Source nuance or generation chosen when a family has variants."
    },
    "sceneHint": "SCENE_SIZE = (characteristicLengthM / 1000 / EARTH_RADIUS_KM) * sizeMagnification. Default sizeMagnification = 1 (true scale vs Earth). Optional Enlarge ×2,500 keeps ratios real while ISS (~0.043 scene) remains visible."
  },
